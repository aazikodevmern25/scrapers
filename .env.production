# Production Environment Configuration for Coolify

# MongoDB Configuration
# Use MongoDB Atlas or self-hosted MongoDB
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=jaimish_data

# Celery Configuration
# Use Redis Cloud or self-hosted Redis
CELERY_BROKER_URL=redis://:password@redis-host:6379/0
CELERY_RESULT_BACKEND=redis://:password@redis-host:6379/0

# FastAPI Configuration
ENVIRONMENT=production
DEBUG=false

# CORS Configuration
ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# Logging
LOG_LEVEL=info
